[
  {
    "mode": [
      "global"
    ],
    "syntax": "ip route {<ip-prefix> <mask> | <ip-prefix>/<prefix-length>} {<gateway-address> | <gateway-interface>} [<distance>]",
    "params": {
      "<ip-prefix>": "目标网络前缀",
      "<mask> | <prefix-length>": "子网掩码或前缀长度",
      "<gateway-address> | <gateway-interface>": "网关IP地址或网关接口",
      "<distance>": "管理距离"
    },
    "desc": "配置静态路由",
    "requires": "",
    "state_key": "ip.route.static",
    "no_cmd": "no ip route {<ip-prefix> <mask> | <ip-prefix>/<prefix-length>} [<gateway-address> | <gateway-interface>] [<distance>]",
    "output_example": ""
  },
  {
    "mode": [
      "global"
    ],
    "syntax": "router ospf [<id>] [vrf <vrf-name>]",
    "params": {
      "<id>": "OSPF 进程号（可选）",
      "<vrf-name>": "VRF 实例名称（可选）"
    },
    "desc": "启动 OSPF协议进程",
    "requires": "",
    "state_key": "router.ospf",
    "no_cmd": "no router ospf [process <id>]",
    "output_example": ""
  },
  {
